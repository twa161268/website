<%- include('../partials/header', { pageTitle: article.judul, footer }) %>

<section class="content-page article-detail">

  <a class="all-link" href="/artikel">
    ← Info Vearich
  </a>

  <h1>
    <%= article.judul %>
  </h1>

  <time>
    <%= article.created_at
      ? new Date(article.created_at).toLocaleDateString(
          'id-ID',
          {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
          }
        )
      : ''
    %>
  </time>

  <!-- =====================================================
       CONTENT BLOCK ARTIKEL
       ===================================================== -->

  <% if (contents && contents.length > 0) { %>

    <div class="article-content">

      <% contents.forEach((content) => { %>

        <!-- =========================
             TEKS
             ========================= -->

        <% if (content.tipe === 'TEKS') { %>

          <div class="article-content-text rich-content">
            <%= content.isi || '' %>
          </div>

        <!-- =========================
             GAMBAR
             ========================= -->

        <% } else if (content.tipe === 'GAMBAR') { %>

          <% if (/\.pdf(?:[?#].*)?$/i.test(content.media_url || '')) { %>
            <div class="article-content-pdf">
              <iframe src="<%= content.media_url %>#toolbar=1&navpanes=0" title="Dokumen PDF <%= article.judul %>" loading="lazy"></iframe>
              <p><a href="<%= content.media_url %>" target="_blank" rel="noopener">Buka atau unduh PDF</a></p>
            </div>
          <% } else { %>
            <div class="article-content-image">
              <img src="<%= content.media_url %>" alt="<%= article.judul %>" loading="lazy">
            </div>
          <% } %>

        <!-- =========================
             VIDEO
             ========================= -->

        <% } else if (content.tipe === 'VIDEO') { %>

          <div class="article-content-video">
            <video
              controls
              preload="metadata"
              playsinline
            >
              <source src="<%= content.media_url %>">
              Browser Anda tidak mendukung video.
            </video>
          </div>

        <% } %>

      <% }) %>

    </div>

  <% } else { %>

    <div class="rich-content">
      Belum ada isi artikel.
    </div>

  <% } %>

</section>

<%- include('../partials/footer', { footer }) %>
