<%- include('../partials/header', { pageTitle: 'About Us', footer, currentPage: 'about' }) %>

<section class="about-page content-page" aria-label="About Us, Misi, dan Visi">
  <header class="about-page-heading">
    <span>WHO WE ARE</span>
    <h1>About Us</h1>
    <p>Mengenal kami, misi, dan visi yang menjadi arah perjalanan kami.</p>
  </header>

  <% const orderedSections = (sections || []).slice(); %>

  <% orderedSections.forEach((section, index) => { %>
    <article class="about-page-section <%= index % 2 === 0 ? 'about-page-section-even' : 'about-page-section-odd' %>" id="<%= section.judul.toLowerCase() %>">
      <% if (section.image && section.image.gambar) { %>
        <div class="about-page-image">
          <img src="<%= section.image.gambar %>" alt="<%= section.judul %>" loading="lazy">
        </div>
      <% } %>
      <% if (section.content && section.content.isi) { %>
        <div class="about-page-copy">
          <div class="rich-content"><%- section.content.isi %></div>
        </div>
      <% } %>
    </article>
  <% }); %>
</section>

<%- include('../partials/footer', { footer }) %>
