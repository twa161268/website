<%- include('../partials/header', { pageTitle: 'Articles', footer }) %>

<section class="content-page article-list-page">

  <a class="all-link" href="/">
    ← Home
  </a>

  <h1>
    Info Vearich…
  </h1>

  <div class="article-cards article-list-grid">

    <% articles.forEach(article => { %>

      <article class="article-card">

        <a href="/artikel/<%= article.slug %>">

          <% if (article.thumbnail) { %>

            <img
              src="<%= article.thumbnail %>"
              alt="<%= article.judul %>"
            >

          <% } else { %>

            <div class="image-placeholder">
              No Image
            </div>

          <% } %>

          <h2>
            <%= article.judul %>
          </h2>

          <time>
            <%= article.created_at
              ? new Date(article.created_at).toLocaleDateString(
                  'id-ID',
                  {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                  }
                )
              : ''
            %>
          </time>

        </a>

        <%
          const overviewText = article.overview || '';

          const cleanOverview =
            String(overviewText)
              .replace(/<[^>]*>/g, '')
              .replace(/\s+/g, ' ')
              .trim();
        %>

        <p>
          <%= cleanOverview.slice(0, 130) %><%= cleanOverview.length > 130 ? '…' : '' %>
        </p>

      </article>

    <% }) %>

  </div>

</section>

<%- include('../partials/footer', { footer }) %>
