<%- include('../partials/header', { pageTitle: 'Form', footer }) %>
<section class="content-page"><h1>Form</h1><div class="media-grid form-grid">
<% items.forEach(item => { %>
  <article class="media-card"><h2><%= item.judul %></h2>
    <% (item.contents || []).forEach(block => { %>
      <% if (block.tipe === 'TEKS' && block.isi) { %><div class="form-description"><%- block.isi %></div>
      <% } else if (block.tipe === 'GAMBAR' && block.media_url) { %><img src="<%= block.media_url %>" alt="<%= item.judul %>">
      <% } else if (block.tipe === 'VIDEO' && block.media_url) { %><video src="<%= block.media_url %>" controls playsinline preload="metadata"></video><% } %>
    <% }) %>
  </article>
<% }) %>
<% if (!items.length) { %><p>Belum ada konten Form.</p><% } %>
</div></section><%- include('../partials/footer', { footer }) %>
