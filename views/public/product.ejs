<%- include('../partials/header', { pageTitle: 'Product' , footer }) %>

  <section class="content-page">
    <h1>Product</h1>

    <form class="article-search product-search" method="GET" action="/product">
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Cari product..." autocomplete="off">

      <button type="submit">
        Cari
      </button>

    </form>
    <div class="media-grid product-grid">
      <% items.forEach(item=> { %>

        <article class="media-card">

          <% const url=item.gambar || '' ; const isPdf=/\.pdf$/i.test(url); const
            isVideo=/\.(mp4|webm|ogg|mov|m4v)$/i.test(url); %>

            <% if (isPdf) { %>

              <div class="pdf-box">PDF</div>

              <% } else if (isVideo) { %>

                <video class="product-image" src="<%= url %>" controls muted playsinline preload="metadata">
                </video>

                <% } else if (url) { %>

                  <img src="<%= url %>" alt="<%= item.judul %>" class="product-image" data-full-image="<%= url %>"
                    data-title="<%= item.judul %>">

                <% } %>

                    <h2>
                      <%= item.judul %>
                    </h2>

        </article>

        <% }) %>
    </div>
  </section>


<!-- LIGHTBOX PRODUCT -->
<div class="product-lightbox" id="productLightbox">

  <button
    type="button"
    class="product-lightbox-close"
    id="productLightboxClose"
    aria-label="Close"
  >
    &times;
  </button>

  <img
    id="productLightboxImage"
    src=""
    alt=""
  >

  <video
    id="productLightboxVideo"
    controls
    playsinline
    preload="metadata"
  ></video>

  <div
    class="product-lightbox-title"
    id="productLightboxTitle"
  ></div>

</div>


  <script>
document.addEventListener('DOMContentLoaded', function () {

  const lightbox = document.getElementById('productLightbox');

  const lightboxImage =
    document.getElementById('productLightboxImage');

  const lightboxVideo =
    document.getElementById('productLightboxVideo');

  const lightboxTitle =
    document.getElementById('productLightboxTitle');

  const closeButton =
    document.getElementById('productLightboxClose');


  /*
   * IMAGE
   */
  document.querySelectorAll('.product-image').forEach(function (media) {

    media.addEventListener('click', function () {

      const url = media.dataset.fullImage || media.src;
      const title = media.dataset.title || '';

      /*
       * Kalau yang diklik adalah VIDEO
       */
      if (media.tagName === 'VIDEO') {

        lightboxImage.style.display = 'none';

        lightboxVideo.style.display = 'block';
        lightboxVideo.src = media.currentSrc || media.src;

        lightboxTitle.textContent = title;

        lightbox.classList.add('open');

        document.body.style.overflow = 'hidden';

        lightboxVideo.play().catch(function () {
          // Browser bisa menolak autoplay.
          // User tetap bisa menekan tombol Play.
        });

        return;
      }


      /*
       * Kalau yang diklik adalah GAMBAR
       */
      lightboxVideo.pause();
      lightboxVideo.removeAttribute('src');
      lightboxVideo.load();
      lightboxVideo.style.display = 'none';

      lightboxImage.src = url;
      lightboxImage.alt = title;
      lightboxImage.style.display = 'block';

      lightboxTitle.textContent = title;

      lightbox.classList.add('open');

      document.body.style.overflow = 'hidden';

    });

  });


  /*
   * CLOSE LIGHTBOX
   */
  function closeLightbox() {

    lightbox.classList.remove('open');

    lightboxImage.src = '';

    lightboxVideo.pause();
    lightboxVideo.removeAttribute('src');
    lightboxVideo.load();

    document.body.style.overflow = '';

  }


  closeButton.addEventListener('click', closeLightbox);


  /*
   * CLICK DI LUAR MEDIA
   */
  lightbox.addEventListener('click', function (event) {

    if (event.target === lightbox) {
      closeLightbox();
    }

  });


  /*
   * ESCAPE
   */
  document.addEventListener('keydown', function (event) {

    if (event.key === 'Escape') {
      closeLightbox();
    }

  });

});
</script>


  <%- include('../partials/footer', { footer }) %>
