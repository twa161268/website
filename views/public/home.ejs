<%- include('../partials/header', { pageTitle: title?.isi || 'Website', footer, currentPage: 'home' }) %>

<!-- SCREEN 1: HERO + BANNER 1 + BANNER 2 -->
<section class="home-screen1" aria-label="Halaman utama">
  <div
    class="home-hero-stage"
    id="homeHero"
    data-background-wide="<%= backgroundWide?.gambar || '' %>"
    data-background-square="<%= backgroundSquare?.gambar || '' %>"
    data-background-mobile="<%= backgroundMobile?.gambar || '' %>">

    <div class="home-hero-shade" aria-hidden="true"></div>

    <div class="home-hero-copy">
      <h1><%= title?.isi || '' %></h1>
      <p><%= subtitle?.isi || '' %></p>
    </div>

    <% [3, 4].forEach((number) => { const banner = banners.find((item) => item.judul === `BANNER${number}`); if (banner) { const url = banner.gambar || ''; const isVideo = /\.(mp4|webm|ogg|mov|m4v)$/i.test(url); %>
      <% if (banner.artikel_slug) { %>
        <a class="screen1-banner screen1-banner-<%= number %>" href="/artikel/<%= banner.artikel_slug %>" aria-label="Buka artikel: <%= banner.artikel_judul || banner.judul %>">
      <% } else { %>
        <div class="screen1-banner screen1-banner-<%= number %>">
      <% } %>
          <% if (isVideo) { %>
            <video src="<%= url %>" autoplay muted loop playsinline preload="metadata"></video>
          <% } else { %>
            <img src="<%= url %>" alt="<%= banner.judul %>">
          <% } %>
      <% if (banner.artikel_slug) { %></a><% } else { %></div><% } %>
    <% } }); %>
  </div>

  <% [1, 2].forEach((number) => { const banner = banners.find((item) => item.judul === `BANNER${number}`); %>
    <section class="screen1-wide-banner screen1-wide-banner-<%= number %>" aria-label="Banner <%= number %>">
      <% if (banner) { const url = banner.gambar || ''; const isVideo = /\.(mp4|webm|ogg|mov|m4v)$/i.test(url); %>
        <% if (banner.artikel_slug) { %><a href="/artikel/<%= banner.artikel_slug %>" aria-label="Buka artikel: <%= banner.artikel_judul || banner.judul %>"><% } %>
          <% if (isVideo) { %>
            <video src="<%= url %>" autoplay muted loop playsinline preload="metadata"></video>
          <% } else if (url) { %>
            <img src="<%= url %>" alt="<%= banner.judul %>">
          <% } %>
        <% if (banner.artikel_slug) { %></a><% } %>
      <% } %>
    </section>
  <% }); %>
</section>

<!-- SCREEN 2: ABOUT, VISI/MISI, ARTICLES, FOOTER -->
<section class="home-screen2" aria-label="Informasi dan artikel">
  <section class="home-about-section" id="about">
    <div class="home-section-heading"><span>WHO WE ARE</span><h2>About Us</h2></div>
    <% if (aboutSections && aboutSections.length) { %>
      <div class="home-about-grid">
        <% aboutSections.forEach((section) => { %>
          <article class="home-about-item">
            <% if (section.image?.gambar) { %><img src="<%= section.image.gambar %>" alt="<%= section.judul %>"><% } %>
            <% if (section.content?.isi) { %><div class="home-about-copy"><%- section.content.isi %></div><% } %>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>

  <section class="home-vision-section" aria-label="Visi dan Misi">
    <div class="home-vision-card"><h2>Visi</h2></div>
    <div class="home-vision-card"><h2>Misi</h2></div>
  </section>

  <section class="home-articles-section" id="articles">
    <div class="home-section-heading home-articles-heading"><span>OUR STORIES</span><h2>Articles</h2></div>
    <div class="home-article-grid">
      <% articles.forEach((article) => { %>
        <article class="home-article-card">
          <a class="home-article-link" href="/artikel/<%= article.slug %>">
            <% if (article.thumbnail) { %>
              <img src="<%= article.thumbnail %>" alt="<%= article.judul %>" loading="lazy">
            <% } else { %>
              <div class="home-article-placeholder" aria-label="Tidak ada gambar">Article</div>
            <% } %>
            <div class="home-article-text">
              <h3><%= article.judul %></h3>
              <% const cleanOverview = String(article.overview || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim(); %>
              <% if (cleanOverview) { %><p><%= cleanOverview.slice(0, 115) %><%= cleanOverview.length > 115 ? '…' : '' %></p><% } %>
            </div>
          </a>
        </article>
      <% }); %>
      <% if (!articles.length) { %><p class="home-no-articles">Belum ada artikel yang dipublikasikan.</p><% } %>
    </div>
    <div class="home-more-articles"><a href="/artikel">More articles <span aria-hidden="true">→</span></a></div>
  </section>

  <%- include('../partials/footer', { footer, insideScreen: true }) %>
</section>
</main>
</body>
</html>
