<%- include('../partials/header',{pageTitle:'Tulisan'}) %><%- include('../partials/sidebar') %><div class="page-actions"><a class="button primary" href="/admin/tulisan/tambah">+ Tambah Tulisan</a></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Judul</th><th>Isi</th><th>Status</th><th>Pin</th><th>Created At</th><th>Action</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><%= item.id %></td><td><%= item.judul %></td><td><%= String(item.isi||'').replace(/<[^>]*>/g,'').slice(0,80) %></td><td><span class="badge <%= item.status==='1'?'active':'inactive' %>"><%= item.status==='1'?'Aktif':'Nonaktif' %></span></td><td><%= item.statuspin==='1'?'Ya':'Tidak' %></td><td><%= item.created_at ? new Date(item.created_at).toLocaleString('id-ID') : '' %></td><td class="actions"><a href="/admin/tulisan/edit/<%= item.id %>">Edit</a><form method="post" action="/admin/tulisan/delete/<%= item.id %>" data-confirm="Apakah Anda yakin ingin menghapus data ini?"><button class="link-danger">Delete</button></form></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
