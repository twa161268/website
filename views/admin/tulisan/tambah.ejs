<%- include('../partials/header',{pageTitle:'Tambah Tulisan'}) %><%- include('../partials/sidebar') %><% if(error){ %><div class="alert error"><%= error %></div><% } %><form class="admin-form" method="post" action="/admin/tulisan"><label>Judul<input name="judul" value="<%= item?.judul||'' %>" required></label><label>Slug<input name="slug" value="<%= item?.slug||'' %>"></label><label>Isi<textarea name="isi" rows="14"><%= item?.isi||'' %></textarea></label><div class="form-row"><label>Status<select name="status"><option value="1">Aktif</option><option value="0">Nonaktif</option></select></label><label>Status Pin<select name="statuspin"><option value="0">Tidak</option><option value="1">Ya</option></select></label></div><div class="form-actions"><button class="button primary">Simpan</button><a class="button" href="/admin/tulisan">Batal</a></div></form><%- include('../partials/footer') %>
