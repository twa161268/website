<%- include('../partials/header',{pageTitle:'Artikel'}) %><%- include('../partials/sidebar') %>
<div class="page-actions"><a class="button primary" href="/admin/artikel/tambah">+ Tambah Artikel</a></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Judul</th><th>Status</th><th>Pin</th><th>Created At</th><th>Action</th></tr></thead><tbody><% articles.forEach(a=>{ %><tr><td><%= a.id %></td><td><%= a.judul %></td><td><span class="badge <%= a.status==='1'?'active':'inactive' %>"><%= a.status==='1'?'Aktif':'Nonaktif' %></span></td><td><%= a.statuspin==='1'?'Ya':'Tidak' %></td><td><%= a.created_at ? new Date(a.created_at).toLocaleString('id-ID') : '' %></td><td class="actions"><a href="/admin/artikel/detail/<%= a.id %>">Detail</a><a href="/admin/artikel/edit/<%= a.id %>">Edit</a><form method="post" action="/admin/artikel/delete/<%= a.id %>" data-confirm="Apakah Anda yakin ingin menghapus artikel ini?"><button class="link-danger" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div>
<%- include('../partials/footer') %>
