<%- include('../partials/header',{pageTitle:'Edit Artikel'}) %><%- include('../partials/sidebar') %>
<% if(error){ %><div class="alert error"><%= error %></div><% } %><form class="admin-form" method="post" action="/admin/artikel/edit/<%= article.id %>" enctype="multipart/form-data"><label>Judul<input name="judul" value="<%= article.judul %>" required></label><label>Slug<input name="slug" value="<%= article.slug||'' %>"></label><label>Isi<textarea name="isi" rows="12"><%= article.isi||'' %></textarea></label><div class="form-row"><label>Status<select name="status"><option value="1" <%= article.status!=='0'?'selected':'' %>>Aktif</option><option value="0" <%= article.status==='0'?'selected':'' %>>Nonaktif</option></select></label><label>Status Pin<select name="statuspin"><option value="0" <%= article.statuspin!=='1'?'selected':'' %>>Tidak</option><option value="1" <%= article.statuspin==='1'?'selected':'' %>>Ya</option></select></label></div><h2>Gambar Artikel</h2><div class="image-order-list" data-sortable-images><% images.forEach((image,i)=>{ %><div class="admin-image-row"><img src="<%= image.gambar %>" alt=""><div class="image-meta"><strong>Gambar <%= i+1 %></strong><input type="hidden" name="image_ids" value="<%= image.id %>"><label>Urutan<input type="number" name="image_orders" min="1" value="<%= image.urutan || i+1 %>"></label></div><button class="button danger" type="button" data-delete-url="/admin/artikel/gambar/delete/<%= image.id %>" data-confirm="Apakah Anda yakin ingin menghapus gambar artikel ini?">Hapus</button></div><% }) %></div><label>Tambah Gambar Baru<input type="file" name="gambar_baru" accept="image/jpeg,image/png,image/jpg,application/pdf" multiple data-preview-target="#new-article-preview"></label><div id="new-article-preview" class="upload-preview"></div><div class="form-actions"><button class="button primary" type="submit">Simpan Perubahan</button><a class="button" href="/admin/artikel">Kembali</a></div></form>
<%- include('../partials/footer') %>
