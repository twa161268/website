<%- include('../partials/header',{pageTitle:'Detail Artikel'}) %><%- include('../partials/sidebar') %><div class="detail-card"><h2><%= article.judul %></h2><p><strong>Slug:</strong> <%= article.slug %></p><p><strong>Status:</strong> <%= article.status==='1'?'Aktif':'Nonaktif' %> &nbsp; <strong>Pin:</strong> <%= article.statuspin==='1'?'Ya':'Tidak' %></p><div class="rich-content"><%- article.isi||'' %></div><h3>Gambar</h3><div class="detail-images"><% images.forEach(image=>{ %><img src="<%= image.gambar %>" alt="<%= article.judul %>"><% }) %></div><a class="button primary" href="/admin/artikel/edit/<%= article.id %>">Edit</a> <a class="button" href="/admin/artikel">Kembali</a></div><%- include('../partials/footer') %>
