<%- include('../partials/header',{pageTitle:'Tambah Artikel'}) %><%- include('../partials/sidebar') %>
<% if(error){ %><div class="alert error"><%= error %></div><% } %><form class="admin-form" method="post" action="/admin/artikel" enctype="multipart/form-data"><label>Judul<input name="judul" id="judul" value="<%= article?.judul||'' %>" required></label><label>Slug<input name="slug" id="slug" value="<%= article?.slug||'' %>" placeholder="otomatis dari judul"></label><label>Isi<textarea name="isi" rows="12"><%= article?.isi||'' %></textarea></label><div class="form-row"><label>Status<select name="status"><option value="1" <%= article?.status!=='0'?'selected':'' %>>Aktif</option><option value="0" <%= article?.status==='0'?'selected':'' %>>Nonaktif</option></select></label><label>Status Pin<select name="statuspin"><option value="0" <%= article?.statuspin!=='1'?'selected':'' %>>Tidak</option><option value="1" <%= article?.statuspin==='1'?'selected':'' %>>Ya</option></select></label></div><label>Multiple Gambar<input type="file" name="gambar" accept="image/jpeg,image/png,image/jpg,application/pdf" multiple data-preview-target="#article-preview"></label><div id="article-preview" class="upload-preview"></div><div class="form-actions"><button class="button primary" type="submit">Simpan</button><a class="button" href="/admin/artikel">Batal</a></div></form>
<%- include('../partials/footer') %>
