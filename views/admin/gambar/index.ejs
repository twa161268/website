<%- include('../partials/header',{pageTitle:'Gambar'}) %><%- include('../partials/sidebar') %><div class="page-actions"><a class="button primary" href="/admin/gambar/tambah">+ Tambah Gambar</a></div><div class="table-wrap"><table><thead><tr><th>Preview</th><th>Judul</th><th>Kategori</th><th>Status</th><th>Pin</th><th>Created At</th><th>Action</th></tr></thead><tbody><% items.forEach(item=>{ const pdf=/\.pdf$/i.test(item.gambar||''); %><tr><td><% if(pdf){ %><span class="pdf-icon">PDF</span><% }else if(item.gambar){ %><img class="table-thumb" src="<%= item.gambar %>" alt=""><% } %></td><td><%= item.judul %></td><td><%= item.kategori||'' %></td><td><span class="badge <%= item.status==='1'?'active':'inactive' %>"><%= item.status==='1'?'Aktif':'Nonaktif' %></span></td><td><%= item.statuspin==='1'?'Ya':'Tidak' %></td><td><%= item.created_at ? new Date(item.created_at).toLocaleString('id-ID') : '' %></td><td class="actions"><a href="/admin/gambar/edit/<%= item.id %>">Edit</a><form method="post" action="/admin/gambar/delete/<%= item.id %>" data-confirm="Apakah Anda yakin ingin menghapus gambar ini?"><button class="link-danger" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
