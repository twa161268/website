<%- include('../partials/header',{pageTitle:'Edit Gambar'}) %><%- include('../partials/sidebar') %><% if(error){ %><div class="alert error"><%= error %></div><% } %><form class="admin-form" method="post" action="/admin/gambar/edit/<%= item.id %>" enctype="multipart/form-data"><label>Judul<input name="judul" value="<%= item.judul %>" required></label><label>Slug<input name="slug" value="<%= item.slug||'' %>"></label><label>Kategori<select name="kategori" required><% categories.forEach(cat=>{ %><option value="<%= cat %>" <%= item.kategori===cat?'selected':'' %>><%= cat %></option><% }) %></select></label><div class="current-file"><% if(/\.pdf$/i.test(item.gambar||'')){ %><span class="pdf-icon">PDF</span><% }else if(item.gambar){ %><img src="<%= item.gambar %>" alt=""><% } %></div><label>Ganti File<input type="file" name="gambar" accept="image/jpeg,image/png,image/jpg,application/pdf" data-preview-target="#gambar-preview"></label><div id="gambar-preview" class="upload-preview"></div><div class="form-row"><label>Status<select name="status"><option value="1" <%= item.status!=='0'?'selected':'' %>>Aktif</option><option value="0" <%= item.status==='0'?'selected':'' %>>Nonaktif</option></select></label><label>Status Pin<select name="statuspin"><option value="0" <%= item.statuspin!=='1'?'selected':'' %>>Tidak</option><option value="1" <%= item.statuspin==='1'?'selected':'' %>>Ya</option></select></label></div><div class="form-actions"><button class="button primary">Simpan Perubahan</button><a class="button" href="/admin/gambar">Batal</a></div></form><%- include('../partials/footer') %>
